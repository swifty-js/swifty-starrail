{
  "name": "swifty-starrail",
  "version": "0.0.0",
  "description": "star rail toolbox",
  "main": "./out/main/index.js",
  "author": "https://github.com/hangtiancheng",
  "homepage": "https://github.com/hangtiancheng/swifty-starrail",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/swifty-starrail"
  },
  "scripts": {
    "format": "prettier -w .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps || node ./scripts/fix.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release:win": "node scripts/release.mjs win",
    "release:mac": "node scripts/release.mjs mac",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal build/favicon.svg"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/vue": "^1.44.0",
    "@swifty.js/sentry": "^0.0.7",
    "@tanstack/vue-virtual": "^3.13.37",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.9",
    "knex": "^3.3.0",
    "pinia": "^4.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "vue-router": "^5.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "optionalDependencies": {
    "@vite-pwa/assets-generator": "^1.0.2",
    "sharp": "^0.34.5"
  }
}
